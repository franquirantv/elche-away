# Copy to .env.local and paste actual NONPRODUCTION Neon connection strings.
# development: pooled application connection
DATABASE_URL=
# development: direct connection for migrations and synthetic seed
DATABASE_URL_UNPOOLED=
# testing: direct connection to a DIFFERENT, disposable branch/database
TEST_DATABASE_URL=

# development branch: Neon Auth URL and a locally generated secret (32+ chars)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Explicit allowed Neon Auth user.id; empty means DENY all admin operations
ADMIN_USER_ID=
# testing branch: separate URL, secret and explicitly allowed user.id
TEST_NEON_AUTH_BASE_URL=
TEST_NEON_AUTH_COOKIE_SECRET=
TEST_ADMIN_USER_ID=

# Optional public vector style configuration (HTTPS, no credentials or query tokens)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_MAX_ZOOM=19

# Neon Object Storage: nonproduction development credentials only.
# Public bucket with authenticated writes; never NEXT_PUBLIC_* secrets.
STORAGE_ENVIRONMENT=development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
STORAGE_BUCKET=elche-away-public
# Normalized DB hostname (without -pooler), binds Storage to its DB environment.
STORAGE_DATABASE_HOST=
# Separate credentials, endpoint and DB hostname for testing.
TEST_AWS_ACCESS_KEY_ID=
TEST_AWS_SECRET_ACCESS_KEY=
TEST_AWS_ENDPOINT_URL_S3=
TEST_AWS_REGION=eu-central-1
TEST_STORAGE_BUCKET=elche-away-public
TEST_STORAGE_DATABASE_HOST=

# Deployment-only offline preflight bindings; set per Vercel environment after review.
# Do not add production credentials to this local file.
# RELEASE_DATABASE_HOST=<reviewed database hostname without -pooler>
# RELEASE_AUTH_ORIGIN=https://<reviewed Auth hostname>

# First production login only; omit ADMIN_USER_ID while this is set.
# Remove this flag and configure the verified owner ID before final acceptance.
# RELEASE_BOOTSTRAP=1

# Optional read-only Production export into a NEW testing database (db:copy-production).
# Use a valid Neon API key; never put a Production DB URL in DATABASE_URL/TEST_DATABASE_URL.
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_PRODUCTION_BRANCH_ID=
# PRODUCTION_DATABASE_NAME=
# PRODUCTION_DATABASE_HOST= # hostname only, never a connection URI
# PRODUCTION_DATABASE_ROLE=neondb_owner
# PG_BIN_DIR=/opt/homebrew/opt/libpq/bin

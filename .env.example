# Copy to .env.local and paste actual NONPRODUCTION Neon connection strings.
# development: pooled application connection
DATABASE_URL=
# development: direct connection for migrations and synthetic seed
DATABASE_URL_UNPOOLED=
# testing: direct connection to a DIFFERENT, disposable branch/database
TEST_DATABASE_URL=

# development branch: Neon Auth URL and a locally generated secret (32+ chars)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Explicit allowed Neon Auth user.id; empty means DENY all admin operations
ADMIN_USER_ID=
# testing branch: separate URL, secret and explicitly allowed user.id
TEST_NEON_AUTH_BASE_URL=
TEST_NEON_AUTH_COOKIE_SECRET=
TEST_ADMIN_USER_ID=

# Optional public map provider configuration (HTTPS, no credentials)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION_TEXT=OpenStreetMap contributors
MAP_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
MAP_TILE_MAX_ZOOM=19

# Neon Object Storage: nonproduction development credentials only.
# Public bucket with authenticated writes; never NEXT_PUBLIC_* secrets.
STORAGE_ENVIRONMENT=development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
STORAGE_BUCKET=elche-away-public
# Normalized DB hostname (without -pooler), binds Storage to its DB environment.
STORAGE_DATABASE_HOST=
# Separate credentials, endpoint and DB hostname for testing.
TEST_AWS_ACCESS_KEY_ID=
TEST_AWS_SECRET_ACCESS_KEY=
TEST_AWS_ENDPOINT_URL_S3=
TEST_AWS_REGION=eu-central-1
TEST_STORAGE_BUCKET=elche-away-public
TEST_STORAGE_DATABASE_HOST=
